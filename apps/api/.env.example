NODE_ENV=development
PORT=4000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=postgresql://user:password@localhost:5432/designedprice
SERPAPI_API_KEY=your_serpapi_key_here
JWT_SECRET=change_me_to_a_long_random_string
ALLOWED_IMAGE_HOSTS=your-bucket.s3.amazonaws.com,cdn.example.com
S3_BUCKET=
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=
MAX_IMAGE_BYTES=8388608

# Public https URL of THIS API (used for image URLs when S3 is not configured). e.g. https://designedprice-api.onrender.com
PUBLIC_BASE_URL=
# Comma-separated web origins allowed to call the API in production. e.g. https://designedprice.vercel.app
CORS_ORIGINS=

# Public https URL of THIS API (used for image URLs when S3 is not configured). e.g. https://designedprice-api.onrender.com
PUBLIC_BASE_URL=
