NODE_ENV=development
PORT=4000

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/designedprice

# Marketplace price comparisons
SERPAPI_API_KEY=your_serpapi_key_here

# Authentication: use a long, random secret in production
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Comma-separated HTTPS image hosts permitted by the image URL endpoint
ALLOWED_IMAGE_HOSTS=your-bucket.s3.amazonaws.com,cdn.example.com

# Optional S3 image storage
# Both S3_BUCKET and S3_PUBLIC_BASE_URL are required in production.
S3_BUCKET=
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=

# Maximum accepted image size: 8 MiB
MAX_IMAGE_BYTES=8388608

# Public base URL of this API, used for local-disk image URLs in development.
# Example: http://localhost:4000
PUBLIC_BASE_URL=

# Comma-separated allowed web origins.
# Example: http://localhost:3000
# Set the actual deployed web origin in production.
CORS_ORIGINS=
